#include "rclcpp/rclcpp.hpp"
// 发布里程计消息的头文件
#include "nav_msgs/msg/odometry.hpp"
#include "unitree_go/msg/sport_mode_state.hpp"
// 发布坐标变换的头文件
#include "geometry_msgs/msg/transform_stamped.hpp"
#include "tf2/LinearMath/Quaternion.h"
#include "tf2_ros/transform_broadcaster.h"
// 发布关节状态信息的头文件
#include "sensor_msgs/msg/joint_state.hpp"
#include "unitree_go/msg/low_state.hpp"

#include <array>
#include <string>

using namespace std::placeholders;

// 自定义节点类
class Driver : public rclcpp::Node
{
public:
    Driver() : Node("driver"), body_height_(0.30) 
    {
      RCLCPP_INFO(this->get_logger(), "Driver节点创建, 用于发布里程计消息，坐标变换和关节状态信息");

  const auto external_odom_topic = this->declare_parameter<std::string>("external_odom_topic", "/SMX/Odom_2D");
  odom_child_frame_id_ = this->declare_parameter<std::string>("odom_child_frame_id", "base_footprint");

      // 声明参数
      // this->declare_parameter("publish_tf", true);

      // 获取参数
      // publish_tf = this->get_parameter("publish_tf").as_bool();

      //坐标变换广播器
      tf_bro_ = std::make_unique<tf2_ros::TransformBroadcaster>(*this);

      if (external_odom_topic.empty()) {
        // 运动状态订阅
        sub_ = this->create_subscription<unitree_go::msg::SportModeState>(
            "/lf/sportmodestate", 10, std::bind(&Driver::state_cb, this, _1));
        RCLCPP_INFO(this->get_logger(), "使用 /lf/sportmodestate 作为里程计源");
      } else {
        external_odom_sub_ = this->create_subscription<nav_msgs::msg::Odometry>(
            external_odom_topic, 10, std::bind(&Driver::external_odom_cb, this, _1));
        RCLCPP_INFO(
            this->get_logger(),
            "使用外部里程计源: %s -> /odom, child_frame=%s",
            external_odom_topic.c_str(),
            odom_child_frame_id_.c_str());
      }


      odom_pub_ = this->create_publisher<nav_msgs::msg::Odometry>("odom", 10);
      
      //关节状态发布
      joint_state_pub_ = this->create_publisher<sensor_msgs::msg::JointState>("joint_states", 10);
      low_state_sub_ = this->create_subscription<unitree_go::msg::LowState>("/lf/lowstate", 10, std::bind(&Driver::low_state_cb, this, std::placeholders::_1));
    }

private:
    // 发布关节状态信息
    rclcpp::Publisher<sensor_msgs::msg::JointState>::SharedPtr joint_state_pub_;
    // 订阅低层状态
    rclcpp::Subscription<unitree_go::msg::LowState>::SharedPtr low_state_sub_;
    // 广播坐标变换
    std::unique_ptr<tf2_ros::TransformBroadcaster> tf_bro_;
    //发布里程计
    rclcpp::Publisher<nav_msgs::msg::Odometry>::SharedPtr odom_pub_;
    // 创建订阅者，订阅机器狗高层运动状态
    rclcpp::Subscription<unitree_go::msg::SportModeState>::SharedPtr sub_;
    rclcpp::Subscription<nav_msgs::msg::Odometry>::SharedPtr external_odom_sub_;
    
    // bool publish_tf, odom_published_;
    double body_height_;
    std::string odom_child_frame_id_;

    void publish_odom_and_tf(
        const rclcpp::Time & stamp,
        const std::string & odom_frame_id,
        const geometry_msgs::msg::Pose & pose,
      const geometry_msgs::msg::Twist & twist,
      const std::array<double, 36> & pose_covariance,
      const std::array<double, 36> & twist_covariance)
    {
      geometry_msgs::msg::TransformStamped transform;
      transform.header.stamp = stamp;
      transform.header.frame_id = odom_frame_id;
      transform.child_frame_id = odom_child_frame_id_;
      transform.transform.translation.x = pose.position.x;
      transform.transform.translation.y = pose.position.y;
      transform.transform.translation.z = 0.0;
      transform.transform.rotation = pose.orientation;
      tf_bro_->sendTransform(transform);

      nav_msgs::msg::Odometry odom;
      odom.header.stamp = stamp;
      odom.header.frame_id = odom_frame_id;
      odom.child_frame_id = odom_child_frame_id_;
      odom.pose.pose = pose;
      odom.pose.pose.position.z = 0.0;
      odom.pose.covariance = pose_covariance;
      odom.twist.twist = twist;
      odom.twist.covariance = twist_covariance;
      odom_pub_->publish(odom);
    }

    void state_cb(const unitree_go::msg::SportModeState::SharedPtr state_msg)
    {
        body_height_ = state_msg->body_height + 0.057 - 0.046825;   // 0.057: base_link在趴着的情况下的高度， -0.046825：雷达比base_link低这么多

      rclcpp::Time now = this->now();
      tf2::Quaternion yaw_only_quat;
      yaw_only_quat.setRPY(0.0, 0.0, state_msg->imu_state.rpy[2]);
      yaw_only_quat.normalize();

      geometry_msgs::msg::Pose pose;
      pose.position.x = state_msg->position[0];
      pose.position.y = state_msg->position[1];
      pose.position.z = 0.0;
      pose.orientation.x = yaw_only_quat.x();
      pose.orientation.y = yaw_only_quat.y();
      pose.orientation.z = yaw_only_quat.z();
      pose.orientation.w = yaw_only_quat.w();

      geometry_msgs::msg::Twist twist;
      twist.linear.x = state_msg->velocity[0];
      twist.linear.y = state_msg->velocity[1];
      twist.linear.z = state_msg->velocity[2];
      twist.angular.z = state_msg->yaw_speed;

      const std::array<double, 36> zero_covariance{};
      publish_odom_and_tf(now, "odom", pose, twist, zero_covariance, zero_covariance);
    }

    void external_odom_cb(const nav_msgs::msg::Odometry::SharedPtr odom_msg)
    {
      const auto odom_frame_id = odom_msg->header.frame_id.empty() ? std::string("odom") : odom_msg->header.frame_id;
      publish_odom_and_tf(
          odom_msg->header.stamp,
          odom_frame_id,
          odom_msg->pose.pose,
          odom_msg->twist.twist,
          odom_msg->pose.covariance,
          odom_msg->twist.covariance);
    }

    //订阅低层信息获取关节状态， 组织消息并发布
    void low_state_cb(const unitree_go::msg::LowState::SharedPtr low_state)
    { 

      sensor_msgs::msg::JointState joint_state;

      //组织数据
      joint_state.header.stamp = this->now();          
      joint_state.name = {
        "FL_hip_joint", "FL_thigh_joint", "FL_calf_joint", 
        "FR_hip_joint", "FR_thigh_joint", "FR_calf_joint", 
        "RL_hip_joint", "RL_thigh_joint", "RL_calf_joint", 
        "RR_hip_joint", "RR_thigh_joint", "RR_calf_joint" 
      };

      //遍历低层状态信息中的关节数据
      for(size_t i = 0; i < 12; i++)
      {
        auto motor = low_state->motor_state[i];

        joint_state.position.push_back(motor.q);
      }

      joint_state_pub_->publish(joint_state);
    }
};

int main(int argc, char ** argv)
{
    rclcpp::init(argc, argv);
    rclcpp::spin(std::make_shared<Driver>());
    rclcpp::shutdown();
    return 0;
}




